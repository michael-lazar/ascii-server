#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = ["requests", "pillow"]
# ///
#
# Cross-publish plaintext ASCII art from the legacy static site
# (../mozz) to the ascii.mozz.us art gallery.
#
# Commands:
#   diff                     Compare the legacy scrollfile against the art
#                            posts on the new site and the last-synced
#                            snapshot (ascii/mozz/assets/scrollfile.txt), listing entries
#                            to publish, republish, or sync.
#   publish <slug>           Publish one entry as a new art post, uploading
#                            the pre-rendered .txt and a freshly rendered
#                            PNG image. Repeatable --reference <path> uploads
#                            local reference images as attachments.
#   republish <slug>         Re-upload the .txt and re-rendered PNG for an
#                            existing art post after the artwork was tweaked.
#   sync-scrollfile          Copy the legacy ascii-art.txt to
#                            ascii/mozz/assets/scrollfile.txt, which is served at
#                            /mozz/scroll/scrollfile.txt once deployed.

import argparse
import io
import math
import os
import re
import sys
from pathlib import Path
from urllib.parse import urljoin

import requests
from PIL import Image, ImageDraw, ImageFont

DEFAULT_LEGACY_ROOT = Path(__file__).resolve().parent.parent.parent / "mozz"
SNAPSHOT_FILE = (
    Path(__file__).resolve().parent.parent / "ascii" / "mozz" / "assets" / "scrollfile.txt"
)

# Calibrated to match the retina area screenshots on the older text posts,
# which were captured from TextEdit displaying Menlo 12pt (~14.2px per
# character cell, ~27.3px per line at 2x scale).
FONT_PATH = "/System/Library/Fonts/Menlo.ttc"
FONT_SIZE = 24
LINE_HEIGHT = 28

# Supersampling and gamma darkening compensate for freetype's thin grayscale
# antialiasing, approximating the stem-darkened text rendering on macOS.
SUPERSAMPLE = 2
GAMMA = 1.8


def render_text_image(text: str) -> bytes:
    """
    Rasterize plaintext ASCII art at 2x scale, black Menlo on white.
    """
    font = ImageFont.truetype(FONT_PATH, FONT_SIZE * SUPERSAMPLE)
    lines = text.splitlines()
    cols = max(len(line) for line in lines)
    width = math.ceil(cols * font.getlength("M"))
    height = len(lines) * LINE_HEIGHT * SUPERSAMPLE

    image = Image.new("L", (width, height), "white")
    draw = ImageDraw.Draw(image)
    for i, line in enumerate(lines):
        draw.text((0, i * LINE_HEIGHT * SUPERSAMPLE), line, font=font, fill="black")

    image = image.resize(
        (math.ceil(width / SUPERSAMPLE), math.ceil(height / SUPERSAMPLE)),
        Image.LANCZOS,
    )
    image = image.point([round(255 * (v / 255) ** GAMMA) for v in range(256)])

    buffer = io.BytesIO()
    image.save(buffer, format="PNG", dpi=(144, 144))
    return buffer.getvalue()


def build_session(token: str) -> requests.Session:
    session = requests.Session()
    session.headers["Authorization"] = f"Bearer {token}"
    return session


def parse_scroll_entries(data: str) -> list[dict]:
    """
    Parse a scrollfile into entries, newest first.

    Sections are separated by "%" lines; the first section is the page
    header. Each entry ends with a date line followed by the title, which
    may wrap onto multiple lines. This mirrors parse_art_meta() in the
    legacy build_art_gallery script.
    """
    data = data.replace("\r\n", "\n")

    entries = []
    for section in data.split("\n%\n")[1:]:
        lines = section.rstrip().splitlines(keepends=False)
        offset = -2
        date_str, title = lines[offset:]
        while not date_str.startswith("20"):
            offset -= 1
            title = f"{date_str} {title}"
            date_str = lines[offset]

        title = title.rstrip(".")
        slug = re.sub(r"[\W_]+", "-", title.replace("'", "")).lower().strip("-")
        entries.append({"slug": slug, "date": date_str, "title": title, "text": "\n".join(lines)})

    return entries


def load_legacy_entries(legacy_root: Path) -> list[dict]:
    scrollfile = legacy_root / "public" / "ascii-art.txt"
    if not scrollfile.exists():
        sys.exit(f"Error: legacy scrollfile not found at {scrollfile}")
    return parse_scroll_entries(scrollfile.read_text())


def fetch_post_slugs(session: requests.Session, base_url: str) -> set[str]:
    slugs = set()
    url = urljoin(base_url, "/api/v1/mozz-art-posts/")
    while url:
        resp = session.get(url)
        resp.raise_for_status()
        data = resp.json()
        slugs.update(post["slug"] for post in data["results"])
        url = data["next"]
    return slugs


def format_entry(args, entry: dict) -> str:
    txt_file = args.legacy_root / "public" / "ascii-art" / entry["date"] / f"{entry['slug']}.txt"
    flags = "" if txt_file.exists() else "  [MISSING TXT]"
    return f"  {entry['date']}  {entry['slug']:<30} {entry['title']}{flags}"


def cmd_diff(args, session: requests.Session) -> None:
    legacy_entries = load_legacy_entries(args.legacy_root)
    post_slugs = fetch_post_slugs(session, args.base_url)

    snapshot = {}
    if SNAPSHOT_FILE.exists():
        snapshot = {e["slug"]: e for e in parse_scroll_entries(SNAPSHOT_FILE.read_text())}

    new_entries = [e for e in legacy_entries if e["slug"] not in post_slugs]
    modified = [
        e
        for e in legacy_entries
        if e["slug"] in post_slugs
        and e["slug"] in snapshot
        and e["text"] != snapshot[e["slug"]]["text"]
    ]
    unsynced = [e for e in legacy_entries if e["slug"] in post_slugs and e["slug"] not in snapshot]

    if not any([new_entries, modified, unsynced]):
        print("Everything is in sync.")
        return

    if new_entries:
        print(f"New entries to publish ({len(new_entries)}, newest first):")
        for entry in new_entries:
            print(format_entry(args, entry))

    if modified:
        print(f"Modified entries to republish ({len(modified)}):")
        for entry in modified:
            print(format_entry(args, entry))

    if unsynced:
        print(f"Published entries missing from the scrollfile ({len(unsynced)}):")
        for entry in unsynced:
            print(format_entry(args, entry))
        print("Run sync-scrollfile to update ascii/mozz/assets/scrollfile.txt.")


def load_entry_files(args, slug: str) -> tuple[dict, bytes, bytes]:
    """
    Return the legacy entry with the raw .txt bytes and rendered PNG bytes.
    """
    entries = {entry["slug"]: entry for entry in load_legacy_entries(args.legacy_root)}
    entry = entries.get(slug)
    if entry is None:
        sys.exit(f"Error: slug '{slug}' not found in the legacy scrollfile")

    txt_file = args.legacy_root / "public" / "ascii-art" / entry["date"] / f"{slug}.txt"
    if not txt_file.exists():
        sys.exit(f"Error: {txt_file} not found (run the legacy publish-art first)")

    txt_bytes = txt_file.read_bytes()
    png_bytes = render_text_image(txt_bytes.decode("utf-8"))
    return entry, txt_bytes, png_bytes


def cmd_publish(args, session: requests.Session) -> None:
    entry, txt_bytes, png_bytes = load_entry_files(args, args.slug)

    reference_paths = [Path(p).expanduser() for p in args.reference]
    for path in reference_paths:
        if not path.exists():
            sys.exit(f"Error: reference image not found at {path}")

    detail_url = urljoin(args.base_url, f"/api/v1/mozz-art-posts/{entry['slug']}/")
    resp = session.get(detail_url)
    if resp.status_code == 200:
        sys.exit(f"Error: an art post with slug '{entry['slug']}' already exists")

    print(f"Publishing '{entry['title']}' ({entry['date']})...")
    resp = session.post(
        urljoin(args.base_url, "/api/v1/mozz-art-posts/"),
        data={
            "slug": entry["slug"],
            "date": entry["date"],
            "title": entry["title"],
            "file_type": "text",
            "font_name": "menlo",
            # DRF treats a boolean missing from multipart form data as an
            # unchecked checkbox (False), ignoring the model default
            "visible": "true",
        },
        files={
            "file": (f"{entry['slug']}.txt", txt_bytes),
            "image_x1": (f"{entry['slug']}.png", png_bytes),
        },
    )
    if resp.status_code != 201:
        sys.exit(f"Error: create failed with {resp.status_code}: {resp.text}")

    post = resp.json()

    for number, path in enumerate(reference_paths, start=1):
        print(f"Uploading attachment {path.name}...")
        with open(path, "rb") as fp:
            resp = session.post(
                urljoin(args.base_url, "/api/v1/mozz-art-post-attachments/"),
                data={"post": entry["slug"], "name": f"Reference #{number}"},
                files={"file": (path.name, fp)},
            )
        if resp.status_code != 201:
            sys.exit(f"Error: attachment upload failed with {resp.status_code}: {resp.text}")

    public_url = urljoin(args.base_url, f"/mozz/posts/{entry['date']}/{entry['slug']}/")
    print(f"Published: {public_url}")
    print(f"File: {post['file']}")
    print(f"Image: {post['image_x1']}")


def cmd_republish(args, session: requests.Session) -> None:
    entry, txt_bytes, png_bytes = load_entry_files(args, args.slug)

    detail_url = urljoin(args.base_url, f"/api/v1/mozz-art-posts/{entry['slug']}/")
    resp = session.get(detail_url)
    if resp.status_code == 404:
        sys.exit(f"Error: no art post with slug '{entry['slug']}' exists, use publish instead")
    resp.raise_for_status()

    print(f"Republishing '{entry['title']}' ({entry['date']})...")
    resp = session.patch(
        detail_url,
        files={
            "file": (f"{entry['slug']}.txt", txt_bytes),
            "image_x1": (f"{entry['slug']}.png", png_bytes),
        },
    )
    if resp.status_code != 200:
        sys.exit(f"Error: update failed with {resp.status_code}: {resp.text}")

    post = resp.json()

    public_url = urljoin(args.base_url, f"/mozz/posts/{entry['date']}/{entry['slug']}/")
    print(f"Republished: {public_url}")
    print(f"File: {post['file']}")
    print(f"Image: {post['image_x1']}")


def cmd_sync_scrollfile(args, session: requests.Session) -> None:
    scrollfile = args.legacy_root / "public" / "ascii-art.txt"
    text = scrollfile.read_text()
    SNAPSHOT_FILE.write_text(text)
    print(f"Updated {SNAPSHOT_FILE} ({len(text)} bytes)")
    print("Commit and push the change, then run: app-deploy ascii-server")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--legacy-root",
        type=Path,
        default=DEFAULT_LEGACY_ROOT,
        help=f"Path to the legacy mozz project (default: {DEFAULT_LEGACY_ROOT})",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("diff", help="List entries to publish, republish, or sync")

    publish_parser = subparsers.add_parser("publish", help="Publish one entry as an art post")
    publish_parser.add_argument("slug", help="Slug of the legacy entry to publish")
    publish_parser.add_argument(
        "--reference",
        action="append",
        default=[],
        metavar="PATH",
        help="Local path to a reference image (repeatable)",
    )

    republish_parser = subparsers.add_parser(
        "republish", help="Re-upload the file and image for an existing art post"
    )
    republish_parser.add_argument("slug", help="Slug of the art post to republish")

    subparsers.add_parser(
        "sync-scrollfile", help="Update ascii/mozz/assets/scrollfile.txt from the legacy site"
    )

    args = parser.parse_args()

    token = os.environ.get("ASCII_SERVER_API_TOKEN")
    if not token:
        sys.exit("Error: ASCII_SERVER_API_TOKEN environment variable not set")

    args.base_url = os.environ.get("ASCII_SERVER_BASE_URL", "http://localhost:8000")
    session = build_session(token)

    commands = {
        "diff": cmd_diff,
        "publish": cmd_publish,
        "republish": cmd_republish,
        "sync-scrollfile": cmd_sync_scrollfile,
    }
    commands[args.command](args, session)


if __name__ == "__main__":
    main()
